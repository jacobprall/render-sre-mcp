{
  "name": "render-mcp-server",
  "version": "0.2.0",
  "description": "Render MCP server with SRE workflows: live topology, incident diagnosis, metrics, deploy history",
  "type": "module",
  "bin": {
    "render-mcp-server": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "keywords": [
    "mcp",
    "render",
    "infrastructure",
    "ai-agent"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0-alpha.2",
    "express": "^5.2.1",
    "render-api": "^1.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
